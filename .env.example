# Set the scanner's reserved LAN IPv4 address. Example only: 192.0.2.42
SCANNER_IP=
# The UID and GID that can write to the mounted directories on this host.
SCAN_UID=1000
SCAN_GID=1000
SCAN_PAPER_SIZE=a4
SCAN_WORK_DIR=./work
SCAN_OUTPUT_DIR=./consume

# Settings for the optional Paperless-ngx stack.
PAPERLESS_VERSION=3.4.2
PAPERLESS_BIND_IP=127.0.0.1
PAPERLESS_PORT=8010
PAPERLESS_TIME_ZONE=UTC
PAPERLESS_OCR_LANGUAGE=eng
PAPERLESS_OCR_LANGUAGES=
PAPERLESS_EXPORT_DIR=./export
POSTGRES_PASSWORD=
PAPERLESS_SECRET_KEY=
